# Genshin Abyss Studio .gitignore

# Runtime Cache & Downloaded Proxies
data/cache/*
!data/cache/.gitkeep
data/cache/thumbnails/*
!data/cache/thumbnails/.gitkeep
data/projects/*
!data/projects/.gitkeep
data/output/
output/

# Temporary files & logs
.tmp/
*.log
scratch/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.spec
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
ENV/
.venv/

# Environment Secrets
.env
credentials.json
token.json
*.pem
*.key

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Node
node_modules/
package-lock.json

# Sibling subrepo reference
genshin-abyss-studio/
